APP_NAME="Execution Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MongoDB single-node replica set (transactions for inbox/outbox, ADR-012).
DB_CONNECTION=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=execution

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=workshop
RABBITMQ_PASSWORD=
RABBITMQ_QUEUE=execution.inbox

EXECUTION_QUEUE_CAPACITY=50

L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_CONST_HOST=http://localhost:30080
